# Public URL of the site (used for gift links, QR codes and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign session cookies. Change this before deploying.
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploads + sqlite database live (optional, defaults to ./data)
# DATA_DIR=./data

# Contact + social links (optional overrides)
# NEXT_PUBLIC_CONTACT_EMAIL=hello@lovedigitalgift.com

# Google OAuth is not wired up out of the box. Set both values to enable it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
